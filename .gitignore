# Editors and OS
# ---------------------------------------------------------------------------
.idea/
# Ignore the folder's contents, not the folder, so the shared files below can be re-included.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.iml
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo

