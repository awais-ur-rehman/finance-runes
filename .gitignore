/target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata
perf.data*
flamegraph.svg

# ---------------------------------------------------------------------------
# Personal financial data — never commit, never stage, never push
# ---------------------------------------------------------------------------
# Local databases and their sidecars
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.duckdb

# Real bank statements and exports (fixtures must be anonymised and synthetic)
*.ofx
*.qif
*.qfx
*.pdf
!assets/fixtures/**/*.pdf

# App working directories
/data/
/exports/
/backups/
/attachments/

# ---------------------------------------------------------------------------
