# Normalise line endings in the repository; check out native on Windows.
* text=auto eol=lf

# Source and config are always LF.
*.rs        text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
*.ps1       text eol=crlf

# Binary assets — never diff, never convert.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.icns      binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.pdf       binary
*.db        binary
*.sqlite3   binary

# Keep vendored or generated files out of GitHub's language stats and diffs.
docs/**     linguist-documentation
